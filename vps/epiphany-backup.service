[Unit]
Description=Verified daily backup of Epiphany SQLite
After=epiphany.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/node /opt/epiphany/current/vps/daily-backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups /var/lib/epiphany
