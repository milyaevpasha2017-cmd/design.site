# Copy to /etc/epiphany/server.env, owner root:root, mode 600.
# EnvironmentFile uses literal values; do not source this file in a shell.
SITE_ORIGIN=https://epiphany-int.ru
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=REPLACE_WITH_PASSWORD_HASH
GITHUB_CONTENT_TOKEN=REPLACE_WITH_REPOSITORY_TOKEN
CONTENT_REPO=milyaevpasha2017-cmd/design.site
CONTENT_BRANCH=main
DATABASE_PATH=/var/lib/epiphany/state.sqlite
PORT=3000
