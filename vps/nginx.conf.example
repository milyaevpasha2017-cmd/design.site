# Activate only after a valid certificate exists. See docs/VPS-DEPLOY.md.
server {
    listen 80;
    server_name epiphany-int.ru;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://epiphany-int.ru$request_uri; }
}
server {
    listen 443 ssl;
    server_name epiphany-int.ru;
    ssl_certificate /etc/letsencrypt/live/epiphany-int.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/epiphany-int.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 7200k;
    client_body_timeout 30s;
    access_log off;
    error_log /var/log/nginx/epiphany-error.log warn;
    gzip on;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Connection "";
        proxy_read_timeout 90s;
        proxy_cache off;
    }
}
